# Local API (default if unset in code)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Vercel Production / Preview: set the same key in the Vercel dashboard to your Render URL, e.g.
# NEXT_PUBLIC_API_BASE_URL=https://your-service.onrender.com
# (no trailing slash — see docs/deployment-render-vercel.md)
