APP_ENV=dev
LOG_LEVEL=INFO
DATASET_ID=ManikaSaini/zomato-restaurant-recommendation

# Phase 4: Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Phase 6: API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
API_RATE_LIMIT_PER_MINUTE=60

# Phase 8: feedback / telemetry / prompt iteration
# PROMPT_VERSION tags runs in SQLite and response headers (recommendation prompt A/B).
PROMPT_VERSION=v1
# Optional extra system-prompt instructions (append). Use for safe iteration without code edits.
# PROMPT_APPEND=
# FEEDBACK_SQLITE_PATH=logs/phase8_feedback.db

# Streamlit (see docs/streamlit-deployment-phase.md)
# STREAMLIT_BACKEND=local
# STREAMLIT_API_BASE_URL=http://127.0.0.1:8000
