# Used by Next.js Route Handlers to reach Render (`/api/recommend`, `/api/feedback`).
# Local dev — point at Phase 6 API:
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Optional server-only alias (same origin as NEXT_PUBLIC_*). On Vercel you can skip
# NEXT_PUBLIC_* and set only API_BACKEND_ORIGIN so the Render URL is not inlined in JS:
# API_BACKEND_ORIGIN=https://your-service.onrender.com

# Vercel Production / Preview: either set BOTH as below, or ONLY API_BACKEND_ORIGIN.
# NEXT_PUBLIC_API_BASE_URL=https://your-service.onrender.com
# API_BACKEND_ORIGIN=https://your-service.onrender.com
# (no trailing slash — see docs/deployment-render-vercel.md)
